{
  "name": "qingzhi-weapp",
  "version": "0.1.0",
  "private": true,
  "description": "轻知闯关微信小程序",
  "templateInfo": {
    "name": "default",
    "typescript": true,
    "css": "None",
    "framework": "React"
  },
  "scripts": {
    "build:weapp": "NODE_ENV=production taro build --type weapp",
    "build:weapp:dev": "NODE_ENV=development taro build --type weapp",
    "dev:weapp": "NODE_ENV=development taro build --type weapp --watch",
    "types:api": "openapi-typescript --output src/api/schema.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "browserslist": [
    "defaults and fully supports es6-module",
    "maintained node versions"
  ],
  "dependencies": {
    "@babel/runtime": "^7.24.4",
    "@tarojs/components": "4.3.3",
    "@tarojs/helper": "4.3.3",
    "@tarojs/plugin-platform-weapp": "4.3.3",
    "@tarojs/runtime": "4.3.3",
    "@tarojs/shared": "4.3.3",
    "@tarojs/taro": "4.3.3",
    "@tarojs/plugin-framework-react": "4.3.3",
    "@tarojs/react": "4.3.3",
    "react-dom": "^18.0.0",
    "react": "^18.0.0"
  },
  "devDependencies": {
    "@tarojs/plugin-generator": "4.3.3",
    "@babel/core": "^7.24.4",
    "@tarojs/cli": "4.3.3",
    "@babel/plugin-transform-class-properties": "7.25.9",
    "@types/webpack-env": "^1.13.6",
    "@types/react": "^18.0.0",
    "webpack": "5.91.0",
    "@tarojs/taro-loader": "4.3.3",
    "@tarojs/webpack5-runner": "4.3.3",
    "babel-preset-taro": "4.3.3",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.5.5",
    "react-refresh": "^0.14.0",
    "@babel/preset-react": "^7.24.1",
    "typescript": "^5.4.5",
    "tsconfig-paths-webpack-plugin": "^4.1.0",
    "postcss": "^8.5.6",
    "@types/node": "^18",
    "@types/minimatch": "^5",
    "openapi-typescript": "7.13.0",
    "tsx": "4.21.0"
  },
  "engines": {
    "node": ">=20.18"
  }
}
